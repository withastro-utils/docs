---
import CodePreview from './CodePreview.astro';
import InstallTabs from './InstallTabs.astro';
import searchCode from '../examples/guide/search.astro.txt?raw';
import type { Example } from '../examples/schema';
const example: Example = { id: 'search', title: 'Search a product collection', description: 'Query a collection on the server and render matching products.', packages: ['forms'], topics: ['binding', 'actions'], difficulty: 'beginner', files: [{ label: 'src/pages/search.astro', code: searchCode, lang: 'astro' }], previewUrl: '/docs/previews/search/', previewStatus: 'static', guideUrl: '/docs/agents/getting-started.md' };
import DraftContentNotice from '@astrojs/starlight/components/DraftContentNotice.astro';

const { data } = Astro.locals.starlightRoute.entry;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<section class="hero" aria-labelledby="_top">
    <div class="hero-copy">
        <p class="eyebrow">Server-first forms for Astro</p>
        <h1 id="_top" data-page-title>Your form.<br />Your server.<br /><span>One place.</span></h1>
        {data.draft && <DraftContentNotice />}
        <p class="lead">Form state, validation, and server actions in your <strong>.astro</strong> components. Build interactive forms with the server tools you already know.</p>
        <div class="actions"><a class="primary" href={`${base}guides/forms/getting-started/`}>Start with Forms <span aria-hidden="true">→</span></a></div>
        <InstallTabs packages="@astro-utils/forms" />
    </div>
    <div class="workspace"><CodePreview {example} /><p class="setup-note">Search an Astro content collection on the server. Render the results here. <a href={`${base}agents/getting-started.md`}>Setup and collection schema →</a></p></div>
</section>

<style>
    .hero { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.15fr); align-items:center; gap:clamp(2rem,4vw,4rem); padding-block:3.5rem 4rem; }
    .hero::before { content:''; position:absolute; z-index:-1; inset:-3rem 0; pointer-events:none; background:radial-gradient(ellipse at 75% 35%,color-mix(in srgb,var(--au-accent) 14%,transparent),transparent 55%); animation:sky-drift 16s ease-in-out infinite alternate; }
    @keyframes sky-drift { to { transform:translateY(1.5rem) scale(.94); opacity:.55; } }
    .hero-copy,.workspace { min-width:0; }
    .eyebrow { margin:0 0 1.4rem; color:var(--au-accent); font:500 .68rem var(--sl-font-mono); letter-spacing:.08em; text-transform:uppercase; }
    h1 { margin:0; color:var(--sl-color-white); font-size:clamp(2.8rem,5vw,4.4rem); font-weight:700; line-height:1.06; letter-spacing:-.05em; }h1 span { color:var(--au-accent); }
    .lead { max-width:29rem; margin:1.5rem 0; color:var(--sl-color-gray-2); font-size:1rem; line-height:1.8; }
    .actions { display:flex; align-items:center; flex-wrap:wrap; gap:1.4rem; margin:1.8rem 0; }
    .primary { display:inline-flex; align-items:center; gap:1rem; padding:.85rem 1.1rem; min-height:2.8rem; border-radius:6px; color:#fff; background:var(--au-action); font-size:.85rem; font-weight:650; text-decoration:none; }.primary:hover { background:#085a90; }
    .secondary { color:var(--au-accent); font-size:.85rem; font-weight:650; text-underline-offset:4px; }
    .workspace { min-width:0; }
    .workspace :global(.code-preview) { margin:0; }.workspace :global(.expressive-code code) { font-size:.8rem; line-height:1.5; }.workspace :global(pre) { max-height:none; }
    .workspace :global([role='tablist']) { justify-content:space-between; width:100%; }.workspace :global([role='tablist'] li:last-child) { margin-inline-start:auto; }
    .setup-note { margin:.8rem .5rem .3rem; color:var(--sl-color-gray-2); font-size:.68rem; line-height:1.7; }.setup-note a { color:var(--au-accent); }
    @media(max-width:58rem) { .hero { grid-template-columns:1fr; padding-block:2rem 3rem; }.workspace { width:100%; }.lead { max-width:36rem; } }
    @media(prefers-reduced-motion:reduce) { .hero::before { animation:none; } }
</style>
