---
import { markdownPath } from '../lib/agent-docs';
const { entry } = Astro.locals.starlightRoute;
const id = entry.id;
const pageTitleId = '_top';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const section = id.startsWith('examples/') ? { label: 'Examples', href: 'examples/' }
    : id.startsWith('reference/forms/') ? { label: 'Forms API', href: 'reference/forms/' }
    : id.startsWith('reference/express/') && !id.endsWith('router-and-errors') ? { label: 'Endpoints API', href: 'reference/express/router-and-errors/' }
    : id.startsWith('guides/forms/') && !id.endsWith('getting-started') ? { label: 'Forms guide', href: 'guides/forms/getting-started/' }
    : null;
---

<header class="page-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={base}>Docs</a><span aria-hidden="true">/</span>{section && <><a href={`${base}${section.href}`}>{section.label}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{entry.data.title}</span></nav>
    <h1 id={pageTitleId}>{entry.data.title}</h1>
    {entry.data.description && <p class="page-description">{entry.data.description}</p>}
    {id !== '404' && <a class="markdown-link" href={markdownPath(id)}>View Markdown</a>}
</header>

<style>
    .markdown-link { display:inline-block; margin-top:.8rem; font-size:.75rem; color:var(--au-accent); }
    .breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin-bottom:1rem; color:var(--sl-color-gray-3); font-size:.72rem; }
    .breadcrumbs a { color:var(--au-accent); text-underline-offset:3px; }
    .page-heading {
        padding-block: clamp(.5rem, 2vw, 1.25rem) 0;
    }

    h1 {
        max-width: 19ch;
        margin: 0;
        color: var(--sl-color-white);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 700;
        line-height: 1.04;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .page-description {
        max-width: 43rem;
        margin: 1rem 0 0;
        color: var(--sl-color-gray-2);
        font-size: clamp(1rem, 1.4vw, 1.12rem);
        line-height: 1.7;
    }

</style>
