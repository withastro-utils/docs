---
import { markdownPath } from '../lib/agent-docs';
const { head, entry } = Astro.locals.starlightRoute;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const image = new URL(`${base}social/${entry.id || 'index'}.png`, Astro.site);
const omitted = new Set(['og:image', 'og:image:alt', 'og:image:width', 'og:image:height', 'twitter:image']);
const filteredHead = head.filter(item => !omitted.has(String(item.attrs?.property ?? item.attrs?.name ?? '')));
---
{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${entry.data.title} — Astro Utils ${entry.id.includes('reference') ? 'API reference' : 'documentation'}`} />
<meta name="twitter:image" content={image.href} />

{entry.id !== '404' && <>
    <link rel="alternate" type="text/markdown" href={new URL(markdownPath(entry.id), Astro.site).href} />
    <link rel="describedby" href={new URL(`${base}llms.txt`, Astro.site).href} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': entry.id === 'index' ? 'WebSite' : 'TechArticle', headline: entry.data.title, description: entry.data.description, url: new URL(`${base}${entry.id === 'index' ? '' : `${entry.id.replace(/\/index$/, '')}/`}`, Astro.site).href }).replace(/</g, '\\u003c')} />
</>}
