---
import DefaultFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<nav aria-label="Explore Astro Utils"><a href={base}>Overview</a><a href={`${base}examples/`}>Examples</a><a href={`${base}guides/forms/getting-started/`}>Start with Forms</a></nav>
<DefaultFooter />
<style>
    nav { display:flex; flex-wrap:wrap; gap:.75rem 1rem; padding-block:1rem; border-top:1px solid var(--au-border); }
    a { color:var(--au-accent); font-size:.85rem; min-height:2.5rem; display:flex; align-items:center; text-underline-offset:4px; }
</style>
