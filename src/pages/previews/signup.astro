---
import '@fontsource-variable/manrope/wght.css';
---

<html lang="en" data-pagefind-ignore>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="robots" content="noindex" />
        <title>Sign-up form preview</title>
        <script is:inline>
            const requestedTheme = new URLSearchParams(window.location.search).get('theme');
            const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.dataset.theme = requestedTheme === 'dark' || requestedTheme === 'light' ? requestedTheme : systemTheme;

            window.addEventListener('message', event => {
                if (event.source !== window.parent || event.data?.type !== 'astro-utils-preview-theme') return;
                if (event.data.theme === 'dark' || event.data.theme === 'light') document.documentElement.dataset.theme = event.data.theme;
            });
        </script>
        <style>
            :root {
                color-scheme: light;
                --preview-page-bg: #f8fbfd;
                --preview-text: #152b3d;
                --preview-muted: #496175;
                --preview-accent: #0b6ead;
                --preview-accent-hover: #085a90;
                --preview-action: #0b6ead;
                --preview-action-hover: #085a90;
                --preview-surface: #fff;
                --preview-field: #f5f9fc;
                --preview-border: #d9e5ed;
                --preview-field-border: #788da0;
                --preview-subtle: #e4f2fb;
                --preview-focus: #0b6ead;
                --preview-shadow: rgba(25, 48, 40, 0.12);
            }
            :root[data-theme='dark'] {
                color-scheme: dark;
                --preview-page-bg: #0b1523;
                --preview-text: #f0f7fc;
                --preview-muted: #b4c8d8;
                --preview-accent: #82cfff;
                --preview-accent-hover: #a4ddff;
                --preview-action: #0b6ead;
                --preview-action-hover: #085a90;
                --preview-surface: #111e30;
                --preview-field: #101c2c;
                --preview-border: #293e53;
                --preview-field-border: #70879e;
                --preview-subtle: #153750;
                --preview-focus: #82cfff;
                --preview-shadow: rgba(0, 0, 0, 0.38);
            }
            * { box-sizing: border-box; }
            body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem; color: var(--preview-text); background: var(--preview-page-bg); font-family: "Manrope Variable", ui-sans-serif, system-ui, sans-serif; }
            main { width: min(100%, 25rem); }
            .eyebrow { margin: 0 0 0.5rem; color: var(--preview-accent); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
            h1 { margin: 0; font-size: 2rem; letter-spacing: 0; }
            .intro { margin: 0.65rem 0 1.5rem; color: var(--preview-muted); }
            form { display: grid; gap: 0.65rem; padding: 1.5rem; border: 1px solid var(--preview-border); border-radius: 14px; background: var(--preview-surface); box-shadow: 0 18px 50px var(--preview-shadow); }
            label { margin-top: 0.35rem; font-size: 0.85rem; font-weight: 750; }
            input { width: 100%; min-height: 2.75rem; padding: 0.7rem 0.8rem; border: 1px solid var(--preview-field-border); border-radius: 8px; color: inherit; background: var(--preview-field); font: inherit; }
            input:focus { outline: 3px solid var(--preview-focus); border-color: var(--preview-accent); }
            button { min-height: 2.9rem; margin-top: 0.75rem; border: 0; border-radius: 8px; color: #ffffff; background: var(--preview-action); font: inherit; font-weight: 800; cursor: pointer; }
            :root[data-theme='light'] button { color: #fff; }
            button:hover { background: var(--preview-action-hover); }
            .notice { display: none; margin: 0.35rem 0 0; padding: 0.8rem; border-left: 3px solid var(--preview-accent); background: var(--preview-subtle); font-size: 0.9rem; }
            .notice[data-visible='true'] { display: block; }
        </style>
    </head>
    <body>
        <main>
            <p class="eyebrow">Astro Utils Forms</p>
            <h1>Create your account</h1>
            <p class="intro">One server-handled form. No client framework required.</p>
            <form id="signup-form">
                <label for="name">Name</label>
                <input id="name" name="name" autocomplete="name" required />
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required />
                <button type="submit">Create account</button>
                <p class="notice" role="status"></p>
            </form>
        </main>
        <script is:inline>
            document.querySelector('#signup-form')?.addEventListener('submit', event => {
                event.preventDefault();
                const notice = document.querySelector('.notice');
                if (notice instanceof HTMLElement) {
                    notice.textContent = `Account details received for ${new FormData(event.currentTarget).get('email')}.`;
                    notice.dataset.visible = 'true';
                }
                event.target.reset();
            });
        </script>
    </body>
</html>
